@using API.Clients
@using BlazorApp.Client.Authentication
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthService AuthService
@inject BlazorAuthenticationStateProvider AuthenticationProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">BolsaTrabajo</a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="ofertas">
                        Ofertas
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <button class="btn btn-link nav-link"
                            @onclick="CerrarSesionAsync">
                        Cerrar sesión
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="login">
                        Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task CerrarSesionAsync()
    {
        await AuthService.LogoutAsync();
        await AuthenticationProvider.NotifyLogoutAsync();

        Navigation.NavigateTo("/login");
    }
}

