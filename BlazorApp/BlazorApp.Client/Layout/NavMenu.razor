@using API.Clients
@using BlazorApp.Client.Authentication
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthService AuthService
@inject BlazorAuthenticationStateProvider AuthenticationProvider
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">BolsaTrabajo</a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="ofertas">
                        Ofertas
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="postulaciones">
                        <AuthorizeView Roles="Alumno" Context="postulacionContext">
                            <Authorized>Mis postulaciones</Authorized>
                            <NotAuthorized>Postulaciones</NotAuthorized>
                        </AuthorizeView>
                    </NavLink>
                </div>

                <AuthorizeView Roles="Administrador,Empresa" Context="gestionContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="alumnos">
                            Alumnos
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Administrador,Empresa" Context="reportesContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="reportes/postulaciones">
                            Reporte de postulaciones
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="reportes/ofertas">
                            Reporte de ofertas
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Administrador" Context="adminContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="empresas">
                            Empresas
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="carreras">
                            Carreras
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="tiposoferta">
                            Tipos de oferta
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Alumno" Context="alumnoContext">
                    @{
                        string rutaPerfil = $"alumnos/editar/{alumnoContext.User.FindFirst(AuthClaims.AlumnoId)?.Value}";
                    }
                    <div class="nav-item px-3">
                        <NavLink class="nav-link"
                                 href="@rutaPerfil">
                            Mi perfil
                        </NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <button class="btn btn-link nav-link"
                            @onclick="CerrarSesionAsync">
                        Cerrar sesión
                    </button>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="login">
                        Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private async Task CerrarSesionAsync()
    {
        await AuthService.LogoutAsync();
        await AuthenticationProvider.NotifyLogoutAsync();

        Navigation.NavigateTo("/login");
    }
}

