@inherits LayoutComponentBase

@using API.Clients
@using DTOs
@using System.Security.Claims
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <!-- Encabezado del menú lateral con fondo oscuro asegurado -->
        <div class="top-row ps-3 navbar navbar-dark bg-dark">
            <div class="container-fluid">
                <span class="navbar-brand text-white fw-bold fs-6">Bolsa de Trabajo</span>
            </div>
        </div>

        <div class="nav-scrollable">
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
                    </NavLink>
                </div>

                <AuthorizeView>
                    <Authorized>
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="ofertas">
                                <span class="bi bi-briefcase-fill-nav-menu" aria-hidden="true"></span> Ofertas
                            </NavLink>
                        </div>

                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="postulaciones">
                                <AuthorizeView Roles="Alumno" Context="postulacionContext">
                                    <Authorized>Mis postulaciones</Authorized>
                                    <NotAuthorized>Postulaciones</NotAuthorized>
                                </AuthorizeView>
                            </NavLink>
                        </div>

                        @* Administrador y Empresa: alumnos y reportes *@
                        <AuthorizeView Roles="Administrador,Empresa" Context="gestionContext">
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="alumnos">
                                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Alumnos
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="reportes/postulaciones">
                                    Reporte de postulaciones
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="reportes/ofertas">
                                    Reporte de ofertas
                                </NavLink>
                            </div>
                        </AuthorizeView>

                        @* Solo Administrador: catálogos *@
                        <AuthorizeView Roles="Administrador" Context="adminContext">
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="empresas">Empresas</NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="carreras">Carreras</NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="tiposoferta">Tipos de oferta</NavLink>
                            </div>
                        </AuthorizeView>

                        @* Solo Alumno: su propio perfil *@
                        <AuthorizeView Roles="Alumno" Context="alumnoContext">
                            @{
                                string rutaPerfil = $"alumnos/editar/{alumnoContext.User.FindFirst(AuthClaims.AlumnoId)?.Value}";
                            }
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="@rutaPerfil">Mi perfil</NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="curriculum">Mi CV</NavLink>
                            </div>
                        </AuthorizeView>
                    </Authorized>
                </AuthorizeView>
            </nav>
        </div>
    </div>

    <main>
        <!-- Barra superior limpia, alineada a la derecha y con fondo sutil -->
        <div class="top-row px-4 d-flex justify-content-end align-items-center bg-white border-bottom shadow-sm" style="height: 60px;">
            <AuthorizeView>
                <Authorized>
                    @{
                        string rol = ObtenerRol(context.User);
                    }
                    <span class="me-3 text-secondary">
                        Conectado como: <strong class="text-dark">@context.User.Identity?.Name</strong>
                        @if (string.IsNullOrEmpty(rol))
                        {
                            <span class="badge bg-warning text-dark ms-1">sin rol: cerrá sesión y volvé a ingresar</span>
                        }
                        else
                        {
                            <span class="badge bg-primary ms-1">@rol</span>
                        }
                    </span>
                    <button class="btn btn-outline-danger btn-sm px-3" @onclick="CerrarSesionAsync">
                        Cerrar sesión
                    </button>
                </Authorized>
                <NotAuthorized>
                    <a href="login" class="btn btn-primary btn-sm">Iniciar sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <!-- Contenido principal con un padding cómodo -->
        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

@code {
    private static string ObtenerRol(ClaimsPrincipal usuario) =>
        usuario.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;

    private async Task CerrarSesionAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}