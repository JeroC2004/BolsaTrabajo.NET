@page "/"

@inject NavigationManager Navigation

<PageTitle>Portal de Empleo - Inicio</PageTitle>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm p-5 text-center" style="max-width: 550px; border: 1px solid #dee2e6; border-radius: 8px;">
        <h1 class="h3 fw-bold text-dark mb-3">
            <AuthorizeView>
                <Authorized>@Titulo(context.User)</Authorized>
                <NotAuthorized>Sistema de Bolsa de Trabajo</NotAuthorized>
            </AuthorizeView>
        </h1>

        <p class="text-secondary mb-4" style="font-size: 1.05rem; line-height: 1.5;">
            <AuthorizeView>
                <Authorized>@Descripcion(context.User)</Authorized>
                <NotAuthorized>Acceda al portal o registre una cuenta nueva para consultar oportunidades laborales.</NotAuthorized>
            </AuthorizeView>
        </p>

        <hr class="my-4 text-muted" />

        <AuthorizeView>
            <Authorized>
                <button class="btn btn-success px-5 py-2"
                        @onclick="IrAOfertas">
                    @(context.User.IsInRole("Administrador") ? "Gestionar ofertas" : context.User.IsInRole("Empresa") ? "Ver mis ofertas" : "Explorar ofertas")
                </button>
            </Authorized>

            <NotAuthorized>
                <div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
                    <button class="btn btn-primary px-5 py-2"
                            @onclick="IrALogin">
                        Iniciar sesión
                    </button>

                    <button class="btn btn-secondary px-5 py-2"
                            @onclick="IrARegistro">
                        Registrarse
                    </button>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private static string Titulo(System.Security.Claims.ClaimsPrincipal usuario) =>
        usuario.IsInRole("Administrador") ? "Panel de administración" :
        usuario.IsInRole("Empresa") ? "Portal de empresas" :
        usuario.IsInRole("Alumno") ? "Tu próximo paso laboral" : "Sistema de Bolsa de Trabajo";

    private static string Descripcion(System.Security.Claims.ClaimsPrincipal usuario) =>
        usuario.IsInRole("Administrador") ? "Administrá ofertas, postulaciones, alumnos y empresas. Consultá reportes y revisá las solicitudes de registro." :
        usuario.IsInRole("Empresa") ? "Gestioná tus ofertas laborales, revisá las postulaciones recibidas y consultá tus reportes." :
        usuario.IsInRole("Alumno") ? "Explorá oportunidades laborales, seguí tus postulaciones y mantené actualizados tu perfil y tu CV." :
        "Consultá las oportunidades laborales disponibles.";
    private void IrALogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void IrARegistro()
    {
        Navigation.NavigateTo("/registro");
    }

    private void IrAOfertas()
    {
        Navigation.NavigateTo("/ofertas");
    }
}
