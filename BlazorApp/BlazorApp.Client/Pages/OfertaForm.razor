@page "/ofertas/nueva"
@page "/ofertas/editar/{OfertaId:int}"

@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@TituloPagina</PageTitle>

<h3>@TituloPagina</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="oferta" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Título</label>
            <InputText class="form-control"
                       @bind-Value="oferta.Titulo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Empresa</label>
            <InputSelect class="form-select"
                         @bind-Value="oferta.EmpresaId">
                <option value="0">Seleccione una empresa</option>

                @foreach (EmpresaDTO empresa in empresas)
                {
                    <option value="@empresa.Id">
                        @empresa.RazonSocial
                    </option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Tipo de oferta</label>
            <InputSelect class="form-select"
                         @bind-Value="oferta.TipoOfertaId">
                <option value="0">Seleccione un tipo</option>

                @foreach (TipoOfertaDTO tipo in tiposOferta)
                {
                    <option value="@tipo.Id">
                        @tipo.Nombre
                    </option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Tipo de vínculo</label>
            <InputSelect class="form-select"
                         @bind-Value="oferta.TipoVinculo">
                <option value="">Seleccione un tipo</option>

                @foreach (string tipo in tiposVinculo)
                {
                    <option value="@tipo">@tipo</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Estado</label>
            <InputSelect class="form-select"
                         @bind-Value="oferta.Estado">
                <option value="">Seleccione un estado</option>

                @foreach (string estado in estados)
                {
                    <option value="@estado">@estado</option>
                }
            </InputSelect>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha desde</label>
                <InputDate class="form-control"
                           @bind-Value="oferta.FechaDesde" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha hasta</label>
                <InputDate class="form-control"
                           @bind-Value="oferta.FechaHasta" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Detalle</label>
            <InputTextArea class="form-control"
                           rows="5"
                           @bind-Value="oferta.Detalle" />
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <button type="submit"
                class="btn btn-primary me-2"
                disabled="@guardando">
            @(guardando ? "Guardando..." : "Guardar")
        </button>

        <button type="button"
                class="btn btn-secondary"
                @onclick="Cancelar">
            Cancelar
        </button>
    </EditForm>
}

@code {
    [Parameter]
    public int? OfertaId { get; set; }

    private OfertaDTO oferta = new();
    private List<EmpresaDTO> empresas = new();
    private List<TipoOfertaDTO> tiposOferta = new();

    private readonly string[] tiposVinculo =
        Enum.GetNames<TipoVinculo>();

    private readonly string[] estados =
        Enum.GetNames<EstadoOferta>();

    private bool cargando;
    private bool guardando;
    private string? errorMessage;

    private bool EsEdicion =>
        OfertaId.HasValue;

    private string TituloPagina =>
        EsEdicion ? "Editar oferta" : "Nueva oferta";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        errorMessage = null;

        try
        {
            var empresasTask = EmpresaApiClient.GetAllAsync();
            var tiposTask = TipoOfertaApiClient.GetAllAsync();

            await Task.WhenAll(empresasTask, tiposTask);

            empresas = (await empresasTask).ToList();
            tiposOferta = (await tiposTask).ToList();

            if (OfertaId.HasValue)
            {
                oferta = await OfertaApiClient.GetAsync(OfertaId.Value);
            }
            else
            {
                oferta.FechaDesde = DateTime.Today;
                oferta.FechaHasta = DateTime.Today.AddMonths(3);
                oferta.Estado = nameof(EstadoOferta.Activa);
            }
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo cargar la oferta: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        errorMessage = null;

        if (!ValidarOferta())
            return;

        guardando = true;

        try
        {
            oferta.Requisitos = new List<RequisitoOfertaDTO>();

            if (EsEdicion)
            {
                await OfertaApiClient.UpdateAsync(oferta);
            }
            else
            {
                await OfertaApiClient.AddAsync(oferta);
            }

            Navigation.NavigateTo("/ofertas");
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"No se pudo guardar la oferta: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private bool ValidarOferta()
    {
        if (string.IsNullOrWhiteSpace(oferta.Titulo))
        {
            errorMessage = "El título es obligatorio.";
            return false;
        }

        if (oferta.EmpresaId <= 0)
        {
            errorMessage = "Debe seleccionar una empresa.";
            return false;
        }

        if (oferta.TipoOfertaId <= 0)
        {
            errorMessage = "Debe seleccionar un tipo de oferta.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(oferta.TipoVinculo))
        {
            errorMessage = "Debe seleccionar un tipo de vínculo.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(oferta.Estado))
        {
            errorMessage = "Debe seleccionar un estado.";
            return false;
        }

        if (oferta.FechaHasta < oferta.FechaDesde)
        {
            errorMessage =
                "La fecha hasta no puede ser anterior a la fecha desde.";

            return false;
        }

        if (string.IsNullOrWhiteSpace(oferta.Detalle))
        {
            errorMessage = "El detalle es obligatorio.";
            return false;
        }

        return true;
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/ofertas");
    }
}