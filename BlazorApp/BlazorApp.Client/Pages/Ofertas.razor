@page "/ofertas"

@using API.Clients
@using DTOs
@using Microsoft.AspNetCore.Authorization
@* Protegemos la ruta para que solo usuarios logueados puedan ver la lista *@
@attribute [Authorize]

@inject NavigationManager Navigation
@inject IJSRuntime JS
@* 1. INYECTAMOS EL CLIENTE AQUÍ *@
@inject API.Clients.OfertaApiClient OfertaClient
@inject API.Clients.PostulacionApiClient PostulacionClient

<PageTitle>Ofertas</PageTitle>

<h1>Ofertas laborales</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control"
           placeholder="Buscar por criterio"
           @bind="criterio" />

    <button class="btn btn-primary"
            @onclick="BuscarAsync">
        Buscar
    </button>

    <button class="btn btn-secondary"
            @onclick="CargarAsync">
        Mostrar todas
    </button>

    <AuthorizeView Roles="Administrador,Empresa">
        <button class="btn btn-success"
                @onclick="NuevaOferta">
            Nueva oferta
        </button>
    </AuthorizeView>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (loading)
{
    <div class="d-flex align-items-center mt-3">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <span>Cargando ofertas...</span>
    </div>
}
else if (ofertas.Count == 0)
{
    <p>No se encontraron ofertas.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Título</th>
                <th>Empresa</th>
                <th>Tipo de oferta</th>
                <th>Vínculo</th>
                <th>Estado</th>
                <th>Desde</th>
                <th>Hasta</th>
                <AuthorizeView Roles="Administrador,Empresa">
                    <th>Acciones</th>
                </AuthorizeView>
                <AuthorizeView Roles="Alumno">
                    <th>Postulación</th>
                </AuthorizeView>
            </tr>
        </thead>

        <tbody>
            @foreach (OfertaDTO oferta in ofertas)
            {
                <tr>
                    <td>@oferta.Titulo</td>
                    <td>@oferta.EmpresaNombre</td>
                    <td>@oferta.TipoOfertaNombre</td>
                    <td>@oferta.TipoVinculo</td>
                    <td>
                        @* Pequeño detalle visual para el estado *@
                        <span class="badge @(oferta.Estado == "Activa" ? "bg-success" : "bg-secondary")">
                            @oferta.Estado
                        </span>
                    </td>
                    <td>@oferta.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@oferta.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <AuthorizeView Roles="Administrador,Empresa">
                        <td>
                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick="() => Editar(oferta.Id)">
                                Editar
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => EliminarAsync(oferta.Id)">
                                Eliminar
                            </button>
                        </td>
                    </AuthorizeView>
                    <AuthorizeView Roles="Alumno">
                        <td>
                            <button class="btn btn-sm btn-primary"
                                    disabled="@(oferta.Estado != "Activa")"
                                    @onclick="() => PostularseAsync(oferta.Id)">
                                Postularme
                            </button>
                        </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<OfertaDTO> ofertas = new();

    private string criterio = string.Empty;
    private string? errorMessage;
    private string? successMessage;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            IEnumerable<OfertaDTO> resultado = await OfertaClient.GetAllAsync();

            ofertas.Clear();
            ofertas.AddRange(resultado);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las ofertas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(criterio))
        {
            await CargarAsync();
            return;
        }

        loading = true;
        errorMessage = null;

        try
        {

            IEnumerable<OfertaDTO> resultado = await OfertaClient.GetByCriteriaAsync(criterio);

            ofertas.Clear();
            ofertas.AddRange(resultado);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al buscar ofertas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PostularseAsync(int ofertaId)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            await PostulacionClient.AddAsync(new PostulacionDTO { OfertaId = ofertaId });
            successMessage = "Te postulaste correctamente. Podés seguir el estado en \"Mis postulaciones\".";
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void NuevaOferta()
    {
        Navigation.NavigateTo("/ofertas/nueva");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/ofertas/editar/{id}");
    }

    private async Task EliminarAsync(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Está seguro de eliminar la oferta seleccionada?");

        if (!confirmar)
            return;

        try
        {
            await OfertaClient.DeleteAsync(id);
            await CargarAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la oferta: {ex.Message}";
        }
    }
}