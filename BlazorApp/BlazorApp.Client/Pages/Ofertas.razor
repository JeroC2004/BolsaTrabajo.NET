@page "/ofertas"

@using API.Clients
@using DTOs
@using Microsoft.AspNetCore.Authorization
@* Protegemos la ruta para que solo usuarios logueados puedan ver la lista *@
@attribute [Authorize]

@inject NavigationManager Navigation
@inject IJSRuntime JS
@* 1. INYECTAMOS EL CLIENTE AQUÍ *@
@inject API.Clients.TipoOfertaApiClient TipoClient
@inject API.Clients.OfertaApiClient OfertaClient

<PageTitle>Ofertas</PageTitle>

<h1>Ofertas laborales</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control"
           placeholder="Buscar por criterio"
           @bind="criterio" />

    <button class="btn btn-primary"
            @onclick="BuscarAsync">
        Buscar
    </button>

    <button class="btn btn-secondary"
            @onclick="LimpiarAsync">
        Mostrar todas
    </button>

    <AuthorizeView Roles="Administrador,Empresa">
        <button class="btn btn-success"
                @onclick="NuevaOferta">
            Nueva oferta
        </button>
    </AuthorizeView>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <label for="f-tipo">Tipo de oferta</label>
        <select id="f-tipo" class="form-select" @bind="filtro.TipoOfertaId">
            <option value="">Todos</option>
            @foreach (var tipo in tipos)
            {
                <option value="@tipo.Id">@tipo.Nombre</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="f-estado">Estado</label>
        <select id="f-estado" class="form-select" @bind="filtro.Estado">
            <option value="">Todos los permitidos</option>
            @foreach (var estado in estados)
            {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="f-vinculo">Vínculo</label>
        <select id="f-vinculo" class="form-select" @bind="filtro.TipoVinculo">
            <option value="">Todos</option>
            @foreach (var vinculo in vinculos)
            {
                <option value="@vinculo">@vinculo</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label for="f-desde">Publicada desde</label>
        <input id="f-desde" type="date" class="form-control" @bind="filtro.Desde" />
    </div>
    <div class="col-md-2">
        <label for="f-hasta">Publicada hasta</label>
        <input id="f-hasta" type="date" class="form-control" @bind="filtro.Hasta" />
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (loading)
{
    <div class="d-flex align-items-center mt-3">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <span>Cargando ofertas...</span>
    </div>
}
else if (ofertas.Count == 0)
{
    <p>No se encontraron ofertas.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Título</th>
                <th>Empresa</th>
                <th>Tipo de oferta</th>
                <th>Vínculo</th>
                <th>Estado</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (OfertaDTO oferta in ofertas)
            {
                <tr>
                    <td>@oferta.Titulo</td>
                    <td>@oferta.EmpresaNombre</td>
                    <td>@oferta.TipoOfertaNombre</td>
                    <td>@oferta.TipoVinculo</td>
                    <td>
                        @* Pequeño detalle visual para el estado *@
                        <span class="badge @(oferta.Estado == "Activa" ? "bg-success" : "bg-secondary")">
                            @oferta.Estado
                        </span>
                    </td>
                    <td>@oferta.FechaDesde.ToString("dd/MM/yyyy")</td>
                    <td>@oferta.FechaHasta.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary me-1" href="@($"ofertas/{oferta.Id}")">Ver detalle</a>
                        <AuthorizeView Roles="Administrador,Empresa">
                            <button class="btn btn-sm btn-warning me-1"
                                    @onclick="() => Editar(oferta.Id)">
                                Editar
                            </button>

                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => EliminarAsync(oferta.Id)">
                                Eliminar
                            </button>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<OfertaDTO> ofertas = new();

    private string criterio = string.Empty;
    private OfertaCriteriaDTO filtro = new();
    private List<TipoOfertaDTO> tipos = new();
    private readonly string[] estados = { "Activa", "Pausada", "Cerrada", "Finalizada" };
    private readonly string[] vinculos = { "Pasantia", "PrimerEmpleo", "PracticaProfesional", "EmpleoFullTime", "EmpleoPartTime" };

    private async Task LimpiarAsync()
    {
        criterio = string.Empty;
        filtro = new();
        await CargarAsync();
    }
    private string? errorMessage;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
        try { tipos = (await TipoClient.GetAllAsync()).ToList(); }
        catch (Exception ex) { errorMessage = $"No se pudieron cargar los tipos: {ex.Message}"; }
    }

    private async Task CargarAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            IEnumerable<OfertaDTO> resultado = await OfertaClient.GetAllAsync();

            ofertas.Clear();
            ofertas.AddRange(resultado);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar las ofertas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (filtro.Desde.HasValue && filtro.Hasta.HasValue && filtro.Desde.Value.Date > filtro.Hasta.Value.Date)
        {
            errorMessage = "La fecha desde no puede superar a la fecha hasta.";
            return;
        }

        loading = true;
        errorMessage = null;

        try
        {

            filtro.Texto = criterio;
            IEnumerable<OfertaDTO> resultado = await OfertaClient.GetByCriteriaAsync(filtro);

            ofertas.Clear();
            ofertas.AddRange(resultado);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al buscar ofertas: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void NuevaOferta()
    {
        Navigation.NavigateTo("/ofertas/nueva");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/ofertas/editar/{id}");
    }

    private async Task EliminarAsync(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            "¿Está seguro de eliminar la oferta seleccionada?");

        if (!confirmar)
            return;

        try
        {
            await OfertaClient.DeleteAsync(id);
            await CargarAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar la oferta: {ex.Message}";
        }
    }
}
