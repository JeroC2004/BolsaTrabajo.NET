@page "/empresas/nuevo"
@page "/empresas/editar/{ItemId:int}"

@using DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = DTOs.Roles.Administrador)]

@inject NavigationManager Navigation
@inject API.Clients.EmpresaApiClient Client

<PageTitle>@TituloPagina</PageTitle>

<h3>@TituloPagina</h3>

@if (cargando)
{
    <p>Cargando datos...</p>
}
else
{
    <EditForm Model="item" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Razón social</label>
            <InputText class="form-control" @bind-Value="item.RazonSocial" />
        </div>

        <div class="mb-3">
            <label>Rubro</label>
            <InputText class="form-control" @bind-Value="item.Rubro" />
        </div>

        <div class="mb-3">
            <label>Descripción</label>
            <InputTextArea class="form-control" rows="3" @bind-Value="item.Descripcion" />
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <button type="submit" class="btn btn-primary" disabled="@guardando">
            @(guardando ? "Guardando..." : "Guardar")
        </button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar">Cancelar</button>
    </EditForm>
}

@code {
    [Parameter] public int? ItemId { get; set; }

    private EmpresaDTO item = new();
    private bool cargando = true;
    private bool guardando = false;
    private string? errorMessage;

    private string TituloPagina => ItemId.HasValue ? "Editar Empresa" : "Nueva empresa";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (ItemId.HasValue)
            {
                item = await Client.GetAsync(ItemId.Value);
            }
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el formulario: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarAsync()
    {
        errorMessage = null;
        guardando = true;

        try
        {
            if (ItemId.HasValue)
                await Client.UpdateAsync(item);
            else
                await Client.AddAsync(item);

            Navigation.NavigateTo("/empresas");
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/empresas");
}
