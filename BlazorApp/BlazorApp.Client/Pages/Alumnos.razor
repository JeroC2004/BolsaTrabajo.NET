@page "/alumnos"

@using API.Clients
@using DTOs
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject API.Clients.AlumnoApiClient AlumnoClient

<PageTitle>Alumnos</PageTitle>

<h1>Gestión de Alumnos</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control"
           placeholder="Buscar por criterio"
           @bind="criterio" />

    <button class="btn btn-primary"
            @onclick="BuscarAsync">
        Buscar
    </button>

    <button class="btn btn-secondary"
            @onclick="CargarAsync">
        Mostrar todos
    </button>

    <button class="btn btn-success"
            @onclick="NuevoAlumno">
        Nuevo alumno
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (loading)
{
    <div class="d-flex align-items-center mt-3">
        <div class="spinner-border text-primary me-2" role="status"></div>
        <span>Cargando alumnos...</span>
    </div>
}
else if (alumnos.Count == 0)
{
    <p>No se encontraron alumnos.</p>
}
else
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Legajo</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>DNI</th>
                <th>Email</th>
                <th>Carrera</th>
                <th>Año</th>
                <th>Promedio</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AlumnoDTO alumno in alumnos)
            {
                <tr>
                    <td>@alumno.Legajo</td>
                    <td>@alumno.NomAlumno</td>
                    <td>@alumno.ApeAlumno</td>
                    <td>@alumno.Dni</td>
                    <td>@alumno.Email</td>
                    <td>@alumno.CarreraNombre</td>
                    <td>@alumno.AnioCurso</td>
                    <td>@alumno.Promedio</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1"
                                @onclick="() => Editar(alumno.Id)">
                            Editar
                        </button>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => EliminarAsync(alumno.Id)">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<AlumnoDTO> alumnos = new();
    private string criterio = string.Empty;
    private string? errorMessage;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        loading = true;
        errorMessage = null;

        try
        {
            IEnumerable<AlumnoDTO> resultado = await AlumnoClient.GetAllAsync();
            alumnos.Clear();
            alumnos.AddRange(resultado);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los alumnos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(criterio))
        {
            await CargarAsync();
            return;
        }

        loading = true;
        errorMessage = null;

        try
        {
            IEnumerable<AlumnoDTO> resultado = await AlumnoClient.GetByCriteriaAsync(criterio);
            alumnos.Clear();
            alumnos.AddRange(resultado);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al buscar alumnos: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void NuevoAlumno()
    {
        Navigation.NavigateTo("/alumnos/nuevo");
    }

    private void Editar(int id)
    {
        Navigation.NavigateTo($"/alumnos/editar/{id}");
    }

    private async Task EliminarAsync(int id)
    {
        bool confirmar = await JS.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar el alumno seleccionado?");
        if (!confirmar) return;

        try
        {
            await AlumnoClient.DeleteAsync(id);
            await CargarAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al eliminar el alumno: {ex.Message}";
        }
    }
}