@* Guía de estudio: Página de ejemplo de Blazor: incrementa un contador al pulsar un botón y demuestra eventos y actualización de la vista. *@
@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    // Incrementa el contador que muestra la página de ejemplo.
    private void IncrementCount()
    {
        currentCount++;
    }
}
