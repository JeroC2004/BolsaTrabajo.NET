@page "/carreras"
@attribute [Authorize]

<PageTitle>Carreras</PageTitle>

<h1>Carreras</h1>

@if (_cargando)
{
    <p>Cargando carreras...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_carreras.Count == 0)
{
    <p>No hay carreras registradas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Departamento</th>
                <th>Duración</th>
            </tr>
        </thead>
        <tbody>
            @foreach (CarreraDTO carrera in _carreras)
            {
                <tr>
                    <td>@carrera.NomCarrera</td>
                    <td>@carrera.Departamento</td>
                    <td>@carrera.Duracion años</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject]
    private CarreraApiClient CarreraApiClient { get; set; } = default!;

    private List<CarreraDTO> _carreras = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IEnumerable<CarreraDTO> carreras =
                await CarreraApiClient.GetAllAsync();

            _carreras = carreras.ToList();
        }
        catch (HttpRequestException)
        {
            _error = "No fue posible obtener las carreras.";
        }
        finally
        {
            _cargando = false;
        }
    }
}