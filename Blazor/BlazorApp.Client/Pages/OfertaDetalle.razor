@page "/ofertas/{Id:int}"
@attribute [Authorize]

<PageTitle>Detalle de oferta</PageTitle>

@if (_cargando)
{
    <p>Cargando oferta...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_oferta is null)
{
    <p>La oferta no existe.</p>
}
else
{
    <h1>@_oferta.Titulo</h1>

    <dl class="row">
        <dt class="col-sm-3">Empresa</dt>
        <dd class="col-sm-9">@_oferta.EmpresaNombre</dd>

        <dt class="col-sm-3">Tipo de oferta</dt>
        <dd class="col-sm-9">@_oferta.TipoOfertaNombre</dd>

        <dt class="col-sm-3">Tipo de vínculo</dt>
        <dd class="col-sm-9">@_oferta.TipoVinculo</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@_oferta.Estado</dd>

        <dt class="col-sm-3">Detalle</dt>
        <dd class="col-sm-9">@_oferta.Detalle</dd>
    </dl>

    @if (_oferta.Requisitos.Count > 0)
    {
        <h2>Requisitos</h2>

        <ul>
            @foreach (RequisitoOfertaDTO requisito in _oferta.Requisitos)
            {
                <li>@requisito</li>
            }
        </ul>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject]
    private OfertaApiClient OfertaApiClient { get; set; } = default!;

    private OfertaDTO? _oferta;
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _oferta = await OfertaApiClient.GetAsync(Id);
        }
        catch (HttpRequestException)
        {
            _error = "No fue posible obtener la oferta.";
        }
        finally
        {
            _cargando = false;
        }
    }
}