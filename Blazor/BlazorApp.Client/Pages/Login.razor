@page "/login"
@using BlazorApp.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorAuthService AuthService
@inject NavigationManager Navigation

<h1>Iniciar sesión</h1>

<EditForm Model="_model" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="username">Usuario</label>
        <InputText
            id="username"
            class="form-control"
            @bind-Value="_model.Username" />
    </div>

    <div class="mb-3">
        <label for="password">Contraseña</label>
        <InputText
            id="password"
            type="password"
            class="form-control"
            @bind-Value="_model.Password" />
    </div>

    <button class="btn btn-primary" disabled="_loading">
        @(_loading ? "Ingresando..." : "Ingresar")
    </button>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="text-danger mt-3">@_error</p>
    }
</EditForm>

@code {
    private readonly LoginModel _model = new();

    private bool _loading;
    private string? _error;

    private async Task LoginAsync()
    {
        _loading = true;
        _error = null;

        bool authenticated = await AuthService.LoginAsync(
            _model.Username,
            _model.Password);

        if (authenticated)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            _error = "Usuario o contraseña inválidos.";
        }

        _loading = false;
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;
    }
}