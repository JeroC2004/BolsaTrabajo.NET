@page "/alumnos"
@attribute [Authorize]

<PageTitle>Alumnos</PageTitle>

<h1>Alumnos</h1>

@if (_cargando)
{
    <p>Cargando alumnos...</p>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="alert alert-danger">@_error</div>
}
else if (_alumnos.Count == 0)
{
    <p>No hay alumnos registrados.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Legajo</th>
                <th>Apellido</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Carrera</th>
                <th>Promedio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (AlumnoDTO alumno in _alumnos)
            {
                <tr>
                    <td>@alumno.Legajo</td>
                    <td>@alumno.ApeAlumno</td>
                    <td>@alumno.NomAlumno</td>
                    <td>@alumno.Email</td>
                    <td>@alumno.CarreraNombre</td>
                    <td>@alumno.Promedio</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject]
    private AlumnoApiClient AlumnoApiClient { get; set; } = default!;

    private List<AlumnoDTO> _alumnos = [];
    private bool _cargando = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IEnumerable<AlumnoDTO> alumnos =
                await AlumnoApiClient.GetAllAsync();

            _alumnos = alumnos.ToList();
        }
        catch (HttpRequestException)
        {
            _error = "No fue posible obtener los alumnos.";
        }
        finally
        {
            _cargando = false;
        }
    }
}